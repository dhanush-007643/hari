# DataVista+ Configuration Template
# PostgreSQL Connection URL format:
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name
# Neon / Supabase Cloud PostgreSQL format:
# DATABASE_URL=postgresql://user:password@ep-xyz.aws.neon.tech/neondb?sslmode=require

# Default fallback (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./datavista.db
SECRET_KEY=your-secure-random-secret-key
PORT=8092
DEBUG=True
